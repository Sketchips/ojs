/* ============================================================================
   MODERN OJS THEME v1.5 - CRITICAL FIXES
   Add this AFTER uploading modern-ojs-theme.css OR paste at bottom of main CSS
   ============================================================================ */

/* ===========================================================================
   FIX 1: NAVIGATION POSITIONING - INLINE WITH HEADER
   =========================================================================== */
.pkp_navigation_primary_row,
.pkp_navigation_primary,
nav.pkp_navigation_primary {
    position: absolute !important;
    left: 200px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    height: auto !important;
    display: inline-flex !important;
    z-index: 100 !important;
}

.pkp_navigation_primary ul {
    display: inline-flex !important;
    height: auto !important;
}

.pkp_navigation_primary li {
    display: inline-block !important;
}

.pkp_navigation_primary a {
    display: inline-block !important;
    padding: 0.7rem 1.1rem !important;
    height: auto !important;
    line-height: normal !important;
}

/* ===========================================================================
   FIX 2: DROPDOWN MENU - HIDE BY DEFAULT (FIX ABOUT KELUAR OTOMATIS)
   =========================================================================== */
.pkp_navigation_primary ul li ul,
.pkp_navigation_primary li .dropdown-menu,
.navbar-nav > li > ul,
.navbar-nav .dropdown-menu {
    display: none !important;
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    background: white !important;
    border: 1px solid #e5e7eb !important;
    border-radius: 8px !important;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    min-width: 200px !important;
    padding: 0.5rem 0 !important;
    margin-top: 0.5rem !important;
    z-index: 1000 !important;
}

/* Show dropdown ONLY on hover */
.pkp_navigation_primary li:hover > ul,
.pkp_navigation_primary li:hover > .dropdown-menu,
.navbar-nav > li:hover > ul {
    display: block !important;
}

/* Dropdown items styling */
.pkp_navigation_primary ul li ul li {
    display: block !important;
    width: 100% !important;
}

.pkp_navigation_primary ul li ul li a {
    display: block !important;
    padding: 0.6rem 1.2rem !important;
    color: #111827 !important;
    background: transparent !important;
    border-radius: 0 !important;
}

.pkp_navigation_primary ul li ul li a:hover {
    background: #f3f4f6 !important;
    color: #0d9488 !important;
}

/* ===========================================================================
   FIX 3: ACCOUNT BUTTON - ULTRA FORCE CUSTOM STYLING
   =========================================================================== */
body .navbar-right > li > a,
body .pkp_navigation_user a,
body #navigationUser a,
body header .navbar-right a {
    background: #1a1a1a !important;
    background-color: #1a1a1a !important;
    color: white !important;
    padding: 0.65rem 1.5rem !important;
    border-radius: 50px !important;
    border: 1px solid rgba(255,255,255,0.2) !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25) !important;
    font-weight: 600 !important;
    font-size: 0.85rem !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    transition: all 0.3s ease !important;
}

body .navbar-right > li > a:hover,
body .pkp_navigation_user a:hover,
body #navigationUser a:hover,
body header .navbar-right a:hover {
    background: #0d9488 !important;
    background-color: #0d9488 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 4px 16px rgba(13,148,136,0.5) !important;
    border-color: #0d9488 !important;
}

/* ===========================================================================
   FIX 4: CAROUSEL - RESPONSIVE SIZE & CENTER ALIGNMENT
   =========================================================================== */
/* Default carousel - responsive max-width */
.carousel,
.homepage-image,
.pkp_page_index .carousel {
    width: 100% !important;
    max-width: 1400px !important;
    height: 420px !important;
    margin: 0 auto 2rem auto !important;
    position: relative !important;
    left: auto !important;
    right: auto !important;
}

/* Carousel items */
.carousel-inner,
.carousel .item {
    width: 100% !important;
    height: 420px !important;
}

/* Carousel images - consistent sizing */
.carousel img,
.carousel-item img {
    width: 100% !important;
    height: 420px !important;
    object-fit: cover !important;
    object-position: center !important;
}

/* Carousel controls - ensure visible */
.carousel-control {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 45px !important;
    height: 45px !important;
    background: rgba(0, 0, 0, 0.5) !important;
    border-radius: 50% !important;
    opacity: 0.8 !important;
    transition: all 0.3s ease !important;
}

.carousel-control.left {
    left: 20px !important;
}

.carousel-control.right {
    right: 20px !important;
}

.carousel-control:hover {
    opacity: 1 !important;
    background: rgba(0, 0, 0, 0.7) !important;
}

/* Carousel indicators */
.carousel-indicators {
    bottom: 20px !important;
}

.carousel-indicators li {
    width: 12px !important;
    height: 12px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.5) !important;
    border: 2px solid white !important;
    margin: 0 5px !important;
}

.carousel-indicators li.active {
    background: white !important;
}

/* ===========================================================================
   FIX 5: RESPONSIVE CAROUSEL SIZES
   =========================================================================== */
@media (max-width: 1600px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        max-width: 1200px !important;
        height: 380px !important;
    }
}

@media (max-width: 1200px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        max-width: 100% !important;
        height: 350px !important;
    }
}

@media (max-width: 991px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 300px !important;
    }
    
    .carousel-control {
        width: 40px !important;
        height: 40px !important;
    }
    
    .carousel-control.left {
        left: 15px !important;
    }
    
    .carousel-control.right {
        right: 15px !important;
    }
}

@media (max-width: 768px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 250px !important;
    }
    
    .carousel-control {
        width: 35px !important;
        height: 35px !important;
    }
    
    .carousel-control.left {
        left: 10px !important;
    }
    
    .carousel-control.right {
        right: 10px !important;
    }
}

@media (max-width: 575px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 220px !important;
    }
    
    .carousel-control {
        width: 30px !important;
        height: 30px !important;
        font-size: 18px !important;
    }
    
    .carousel-indicators li {
        width: 8px !important;
        height: 8px !important;
    }
}

/* ===========================================================================
   END OF CRITICAL FIXES
   =========================================================================== */
/**
 * ============================================================================
 * CRITICAL FIXES v1.6 - MEGA CAROUSEL & NAVIGATION FIX
 * ============================================================================
 * 1. Carousel nyaris full-width seperti Riptek (keluar dari container Bootstrap)
 * 2. Navigation naik masuk header sepenuhnya
 * 3. About dropdown stay saat diklik (tidak hilang)
 * 4. About dropdown background pas (tidak overflow)
 * 5. Account dropdown tidak pakai background box
 * 6. Gambar carousel object-fit: contain (tidak zoom/crop)
 * ============================================================================
 */

/* ============================================================================
   FIX 1: NAVIGATION - NAIK KE HEADER SEPENUHNYA
   ============================================================================ */

/* Navigation positioning - Naik sampai sepenuhnya masuk header */
.pkp_navigation_primary_row,
.pkp_navigation_primary {
    position: absolute !important;
    left: 200px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    z-index: 100 !important;
}

/* Navigation items - adjust height untuk pas header */
.navbar-nav > li,
.pkp_navigation_primary > ul > li,
.pkp_navigation_primary li {
    height: auto !important;
    display: inline-flex !important;
    align-items: center !important;
    position: relative !important;
}

/* Navigation links - height auto untuk flex center */
.navbar-nav > li > a,
.pkp_navigation_primary a {
    padding: 0.65rem 1.2rem !important;
    height: auto !important;
    line-height: 1.5 !important;
    display: inline-flex !important;
    align-items: center !important;
}

/* ============================================================================
   FIX 2: ABOUT DROPDOWN - STAY SAAT DIKLIK (TIDAK HILANG)
   ============================================================================ */

/* Dropdown menu - Hidden by default */
.pkp_navigation_primary ul li ul,
.navbar-nav li ul,
.dropdown-menu {
    display: none !important;
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    background: var(--white) !important;
    border: 1px solid #e5e7eb !important;
    border-radius: var(--radius-md) !important;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    min-width: 220px !important;
    padding: 0.5rem 0 !important;
    margin-top: 0.5rem !important;
    z-index: 9999 !important;
    list-style: none !important;
}

/* Show dropdown on hover OR when has .open/.show class (for click) */
.pkp_navigation_primary li:hover > ul,
.pkp_navigation_primary li.open > ul,
.pkp_navigation_primary li.show > ul,
.navbar-nav li:hover > ul,
.navbar-nav li.open > ul,
.navbar-nav li.show > ul,
.dropdown.open .dropdown-menu,
.dropdown.show .dropdown-menu {
    display: block !important;
}

/* Dropdown items styling */
.pkp_navigation_primary ul li ul li,
.navbar-nav li ul li,
.dropdown-menu li {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* Dropdown links */
.pkp_navigation_primary ul li ul li a,
.navbar-nav li ul li a,
.dropdown-menu li a {
    display: block !important;
    width: 100% !important;
    padding: 0.65rem 1.2rem !important;
    color: var(--text-primary) !important;
    background: transparent !important;
    border-radius: 0 !important;
    height: auto !important;
    line-height: 1.5 !important;
    text-align: left !important;
    white-space: nowrap !important;
    transition: all var(--transition-fast) !important;
}

/* Dropdown links hover */
.pkp_navigation_primary ul li ul li a:hover,
.navbar-nav li ul li a:hover,
.dropdown-menu li a:hover {
    background: var(--light-gray) !important;
    color: var(--accent-teal) !important;
    padding-left: 1.5rem !important;
}

/* Force dropdown to stay open on click (JavaScript fallback via CSS) */
.pkp_navigation_primary li.dropdown-clicked > ul,
.navbar-nav li.dropdown-clicked > ul {
    display: block !important;
}

/* ============================================================================
   FIX 3: ACCOUNT DROPDOWN - NO BACKGROUND BOX
   ============================================================================ */

/* Account dropdown - Clean tanpa background box heavy */
.navbar-right .dropdown-menu,
#navigationUser .dropdown-menu,
.pkp_navigation_user .dropdown-menu {
    background: var(--white) !important;
    border: 1px solid #e5e7eb !important;
    border-radius: var(--radius-md) !important;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12) !important;
    padding: 0.5rem 0 !important;
    min-width: 180px !important;
}

/* Account dropdown items - Simple clean styling */
.navbar-right .dropdown-menu li a,
#navigationUser .dropdown-menu li a,
.pkp_navigation_user .dropdown-menu li a {
    display: block !important;
    padding: 0.6rem 1.2rem !important;
    color: var(--text-primary) !important;
    background: transparent !important;
    border-radius: 0 !important;
    transition: all var(--transition-fast) !important;
}

/* Account dropdown hover - Subtle background saja */
.navbar-right .dropdown-menu li a:hover,
#navigationUser .dropdown-menu li a:hover,
.pkp_navigation_user .dropdown-menu li a:hover {
    background: var(--light-gray) !important;
    color: var(--accent-teal) !important;
}

/* ============================================================================
   FIX 4: MEGA CAROUSEL - NYARIS FULL WIDTH (BREAK OUT BOOTSTRAP)
   ============================================================================ */

/* Container carousel - Break out dari Bootstrap grid */
.homepage-image,
.carousel,
.carousel-inner,
body .homepage-image,
body .carousel {
    width: 100vw !important;
    max-width: none !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    height: 550px !important;
    padding: 0 !important;
    position: relative !important;
    overflow: hidden !important;
}

/* Force full-width untuk carousel wrapper */
.carousel-wrapper,
.homepage-image-wrapper {
    width: 100vw !important;
    max-width: none !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    padding: 0 !important;
}

/* Carousel items full width */
.carousel .item,
.carousel-inner .item,
.carousel-inner > .item {
    width: 100% !important;
    height: 550px !important;
    position: relative !important;
}

/* ============================================================================
   FIX 5: GAMBAR CAROUSEL - OBJECT-FIT CONTAIN (TIDAK ZOOM)
   ============================================================================ */

/* Carousel images - CONTAIN untuk tidak zoom/crop */
.carousel img,
.carousel-item img,
.homepage-image img,
.carousel .item img,
.carousel-inner .item img,
.carousel-inner > .item > img {
    width: 100% !important;
    height: 550px !important;
    object-fit: contain !important; /* CHANGED dari cover ke contain */
    object-position: center center !important;
    display: block !important;
    border-radius: 0 !important;
    background: #000 !important; /* Dark background untuk letterbox */
}

/* Override any existing cover rules */
body .carousel img,
body .homepage-image img {
    object-fit: contain !important;
    background: #000 !important;
}

/* ============================================================================
   FIX 6: CAROUSEL CONTROLS - POSITIONED UNTUK MEGA CAROUSEL
   ============================================================================ */

/* Carousel controls - Positioned untuk full-width carousel */
.carousel-control {
    width: 50px !important;
    height: 50px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    background: rgba(0, 0, 0, 0.6) !important;
    border-radius: 50% !important;
    opacity: 0.8 !important;
    transition: all var(--transition-base) !important;
    z-index: 10 !important;
}

.carousel-control.left {
    left: 30px !important;
}

.carousel-control.right {
    right: 30px !important;
}

.carousel-control:hover {
    opacity: 1 !important;
    background: rgba(0, 0, 0, 0.85) !important;
    transform: translateY(-50%) scale(1.1) !important;
}

.carousel-control .glyphicon {
    font-size: 2rem !important;
    color: var(--white) !important;
    line-height: 50px !important;
}

/* ============================================================================
   FIX 7: CAROUSEL CAPTION - ADJUSTED UNTUK MEGA SIZE
   ============================================================================ */

.carousel-caption {
    position: absolute !important;
    bottom: 50px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 5 !important;
    text-align: center !important;
    width: 90% !important;
    max-width: 1000px !important;
}

.carousel-caption h1,
.carousel-caption h2,
.carousel-caption h3 {
    color: var(--white) !important;
    font-size: 2.8rem !important;
    font-weight: 700 !important;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8) !important;
    margin-bottom: 1rem !important;
}

.carousel-caption p {
    color: var(--white) !important;
    font-size: 1.3rem !important;
    text-shadow: 0 3px 12px rgba(0, 0, 0, 0.7) !important;
}

/* ============================================================================
   FIX 8: RESPONSIVE - MEGA CAROUSEL UNTUK MOBILE
   ============================================================================ */

@media (max-width: 1600px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .homepage-image {
        height: 500px !important;
    }
    
    .carousel img {
        height: 500px !important;
    }
}

@media (max-width: 1200px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .homepage-image {
        height: 420px !important;
    }
    
    .carousel img {
        height: 420px !important;
    }
    
    .carousel-caption h1,
    .carousel-caption h2,
    .carousel-caption h3 {
        font-size: 2.2rem !important;
    }
}

@media (max-width: 991px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .homepage-image {
        height: 350px !important;
    }
    
    .carousel img {
        height: 350px !important;
    }
    
    .carousel-control {
        width: 40px !important;
        height: 40px !important;
    }
    
    .carousel-control.left {
        left: 15px !important;
    }
    
    .carousel-control.right {
        right: 15px !important;
    }
}

@media (max-width: 768px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .homepage-image {
        height: 280px !important;
    }
    
    .carousel img {
        height: 280px !important;
    }
    
    .carousel-caption h1,
    .carousel-caption h2,
    .carousel-caption h3 {
        font-size: 1.6rem !important;
    }
    
    .carousel-caption p {
        font-size: 1rem !important;
    }
}

@media (max-width: 575px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .homepage-image {
        height: 220px !important;
    }
    
    .carousel img {
        height: 220px !important;
    }
    
    .carousel-control {
        width: 35px !important;
        height: 35px !important;
    }
    
    .carousel-caption {
        bottom: 20px !important;
    }
    
    .carousel-caption h1,
    .carousel-caption h2,
    .carousel-caption h3 {
        font-size: 1.2rem !important;
    }
    
    .carousel-caption p {
        font-size: 0.85rem !important;
    }
}

/* ============================================================================
   FIX 9: GRADIENT OVERLAY - UNTUK MEGA CAROUSEL
   ============================================================================ */

/* Gradient overlay - Subtle untuk readability caption */
.carousel-inner::after,
.carousel .item::after {
    content: '' !important;
    position: absolute !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: 50% !important;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%) !important;
    pointer-events: none !important;
    z-index: 2 !important;
}

/* ============================================================================
   END OF CRITICAL FIXES v1.6
   ============================================================================ */
/**
 * ============================================================================
 * CRITICAL FIXES v1.7 - FINAL ADJUSTMENTS
 * ============================================================================
 * 1. Carousel dipanjangin ke kanan (margin adjustment)
 * 2. Logo dinaikkan lebih ke atas (vertical positioning)
 * 3. About dropdown background fix (remove black box)
 * 4. Added detailed comments untuk setiap section
 * ============================================================================
 */

/* ============================================================================
   FIX 1: LOGO POSITIONING - NAIK LEBIH KE ATAS
   ============================================================================ */

/**
 * LOGO VERTICAL POSITIONING
 * - Mengatur posisi logo secara vertikal di header
 * - top: 8px = Jarak dari atas header (ATUR DI SINI untuk naik/turun logo)
 * - Semakin kecil nilai top, semakin ke atas logo
 * - Default: 12px, Fixed: 8px (lebih ke atas)
 */
.navbar-brand,
.pkp_site_name,
.pkp_site_name a {
    position: absolute !important;
    left: 15px !important;
    top: 8px !important; /* LOGO HEIGHT POSITION - Kurangi nilai untuk naikkan logo */
    z-index: 150 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    align-items: flex-start !important; /* Align dari atas, bukan center */
}

/**
 * LOGO IMAGE SIZE
 * - max-height: Tinggi maksimal logo (ATUR DI SINI untuk ukuran logo)
 * - Default: 42px, bisa diubah sesuai kebutuhan
 */
.navbar-brand img,
.pkp_site_name img,
.pkp_site_name a img {
    max-height: 42px !important; /* LOGO SIZE - Tinggi logo dalam pixel */
    width: auto !important;
    height: auto !important;
    display: block !important;
    object-fit: contain !important;
}

/* ============================================================================
   FIX 2: MEGA CAROUSEL - EXTEND KE KANAN (WIDER)
   ============================================================================ */

/**
 * CAROUSEL WIDTH & HORIZONTAL POSITIONING
 * - width: 100vw = Full viewport width
 * - margin-left/right: calc() = Formula untuk break out dari container
 * - Formula: calc(-50vw + 50% + OFFSET)
 * - OFFSET POSITIF = Geser ke kanan
 * - OFFSET NEGATIF = Geser ke kiri
 * - Adjust OFFSET di bawah untuk geser carousel
 */
.homepage-image,
.carousel,
.carousel-inner,
body .homepage-image,
body .carousel {
    width: 100vw !important; /* CAROUSEL WIDTH - Full viewport width */
    max-width: none !important;
    /* CAROUSEL HORIZONTAL POSITION - Adjust nilai setelah + untuk geser kanan/kiri */
    margin-left: calc(-50vw + 50% + 15px) !important; /* +15px = Geser 15px ke kanan */
    margin-right: calc(-50vw + 50% - 15px) !important; /* -15px = Kompensasi geser kanan */
    height: 550px !important; /* CAROUSEL HEIGHT - Tinggi carousel desktop */
    padding: 0 !important;
    position: relative !important;
    overflow: hidden !important;
}

/**
 * CAROUSEL WRAPPER WIDTH
 * - Same formula as carousel untuk consistency
 */
.carousel-wrapper,
.homepage-image-wrapper {
    width: 100vw !important;
    max-width: none !important;
    margin-left: calc(-50vw + 50% + 15px) !important; /* WRAPPER LEFT MARGIN - Sama dengan carousel */
    margin-right: calc(-50vw + 50% - 15px) !important; /* WRAPPER RIGHT MARGIN - Kompensasi */
    padding: 0 !important;
}

/**
 * CAROUSEL ITEM HEIGHT
 * - height: Tinggi setiap carousel item (sama dengan container)
 */
.carousel .item,
.carousel-inner .item,
.carousel-inner > .item {
    width: 100% !important;
    height: 550px !important; /* CAROUSEL ITEM HEIGHT - Harus sama dengan carousel height */
    position: relative !important;
}

/* ============================================================================
   FIX 3: ABOUT DROPDOWN BACKGROUND - REMOVE BLACK BOX
   ============================================================================ */

/**
 * DROPDOWN MENU BACKGROUND
 * - background: Warna background dropdown (white = putih bersih)
 * - border: Border untuk memisahkan dropdown dari background
 * - box-shadow: Shadow untuk depth effect
 * - border-radius: Rounded corners
 */
.pkp_navigation_primary ul li ul,
.navbar-nav li ul,
.dropdown-menu {
    display: none !important;
    position: absolute !important;
    top: 100% !important; /* DROPDOWN TOP POSITION - Jarak dari parent menu */
    left: 0 !important;
    background: #ffffff !important; /* DROPDOWN BACKGROUND COLOR - Putih bersih */
    border: 1px solid #e5e7eb !important; /* DROPDOWN BORDER - Subtle gray border */
    border-radius: 10px !important; /* DROPDOWN BORDER RADIUS - Rounded corners */
    box-shadow: 0 10px 25px rgba(0,0,0,0.12) !important; /* DROPDOWN SHADOW - Soft shadow */
    min-width: 220px !important; /* DROPDOWN MIN WIDTH - Lebar minimal dropdown */
    padding: 0.5rem 0 !important; /* DROPDOWN PADDING - Vertical padding */
    margin-top: 0.5rem !important; /* DROPDOWN TOP MARGIN - Spacing dari parent */
    z-index: 9999 !important;
    list-style: none !important;
}

/**
 * REMOVE BLACK/DARK BACKGROUND OVERLAY
 * - Ensure no dark background behind dropdown
 */
.pkp_navigation_primary ul li ul::before,
.navbar-nav li ul::before,
.dropdown-menu::before,
.pkp_navigation_primary ul li ul::after,
.navbar-nav li ul::after,
.dropdown-menu::after {
    display: none !important; /* Remove any pseudo-elements creating dark background */
}

/**
 * DROPDOWN ITEMS STYLING
 * - Clean white background for each item
 */
.pkp_navigation_primary ul li ul li,
.navbar-nav li ul li,
.dropdown-menu li {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important; /* DROPDOWN ITEM BACKGROUND - Transparent by default */
}

/**
 * DROPDOWN LINK STYLING
 * - Styling untuk link di dalam dropdown
 */
.pkp_navigation_primary ul li ul li a,
.navbar-nav li ul li a,
.dropdown-menu li a {
    display: block !important;
    width: 100% !important;
    padding: 0.65rem 1.2rem !important; /* DROPDOWN LINK PADDING - Vertical & horizontal */
    color: #111827 !important; /* DROPDOWN LINK COLOR - Dark gray text */
    background: transparent !important;
    border-radius: 0 !important;
    height: auto !important;
    line-height: 1.5 !important;
    text-align: left !important;
    white-space: nowrap !important;
    transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1) !important;
    text-decoration: none !important;
}

/**
 * DROPDOWN LINK HOVER EFFECT
 * - background: Light gray saat hover
 * - color: Teal accent saat hover
 */
.pkp_navigation_primary ul li ul li a:hover,
.navbar-nav li ul li a:hover,
.dropdown-menu li a:hover {
    background: #f3f4f6 !important; /* DROPDOWN HOVER BACKGROUND - Light gray */
    color: #0d9488 !important; /* DROPDOWN HOVER COLOR - Teal accent */
    padding-left: 1.5rem !important; /* DROPDOWN HOVER INDENT - Slide right effect */
}

/**
 * SHOW DROPDOWN ON HOVER OR OPEN CLASS
 * - .open class = Added by JavaScript when clicked
 * - :hover = Show on mouse hover
 */
.pkp_navigation_primary li:hover > ul,
.pkp_navigation_primary li.open > ul,
.pkp_navigation_primary li.show > ul,
.navbar-nav li:hover > ul,
.navbar-nav li.open > ul,
.navbar-nav li.show > ul,
.dropdown.open .dropdown-menu,
.dropdown.show .dropdown-menu {
    display: block !important; /* DROPDOWN DISPLAY - Show dropdown */
}

/* ============================================================================
   FIX 4: NAVIGATION POSITIONING - FINE TUNING
   ============================================================================ */

/**
 * NAVIGATION HORIZONTAL POSITIONING
 * - left: Jarak dari kiri (ATUR DI SINI untuk geser nav kanan/kiri)
 * - Default: 200px dari kiri
 * - Increase untuk geser ke kanan, decrease untuk ke kiri
 */
.pkp_navigation_primary_row,
.pkp_navigation_primary {
    position: absolute !important;
    left: 200px !important; /* NAVIGATION LEFT POSITION - Jarak dari logo */
    top: 50% !important;
    transform: translateY(-50%) !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    z-index: 100 !important;
}

/**
 * NAVIGATION LINKS SPACING
 * - padding: Internal spacing di dalam link
 * - margin: Spacing antar link
 */
.navbar-nav > li > a,
.pkp_navigation_primary a {
    padding: 0.65rem 1.2rem !important; /* NAVIGATION LINK PADDING - Vertical & horizontal */
    margin: 0 0.15rem !important; /* NAVIGATION LINK SPACING - Spacing antar menu */
    height: auto !important;
    line-height: 1.5 !important;
    display: inline-flex !important;
    align-items: center !important;
}

/* ============================================================================
   FIX 5: CAROUSEL IMAGE FIT - CONTAIN (NO ZOOM)
   ============================================================================ */

/**
 * CAROUSEL IMAGE OBJECT FIT
 * - object-fit: contain = Show full image without crop
 * - object-fit: cover = Fill container, may crop image
 * - background: Black letterbox untuk aspect ratio berbeda
 */
.carousel img,
.carousel-item img,
.homepage-image img,
.carousel .item img,
.carousel-inner .item img,
.carousel-inner > .item > img {
    width: 100% !important;
    height: 550px !important; /* IMAGE HEIGHT - Harus sama dengan carousel height */
    object-fit: contain !important; /* IMAGE FIT MODE - contain = no zoom/crop */
    object-position: center center !important; /* IMAGE POSITION - Center horizontal & vertical */
    display: block !important;
    border-radius: 0 !important;
    background: #000 !important; /* IMAGE LETTERBOX BACKGROUND - Black background */
}

/* ============================================================================
   FIX 6: CAROUSEL CONTROLS POSITIONING
   ============================================================================ */

/**
 * CAROUSEL PREV/NEXT BUTTONS
 * - width/height: Ukuran button (ATUR DI SINI untuk ukuran button)
 * - left/right: Posisi horizontal button dari edge
 */
.carousel-control {
    width: 50px !important; /* CONTROL BUTTON SIZE - Width & height */
    height: 50px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    background: rgba(0, 0, 0, 0.6) !important; /* CONTROL BACKGROUND - Semi-transparent black */
    border-radius: 50% !important; /* CONTROL SHAPE - Circle */
    opacity: 0.8 !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    z-index: 10 !important;
}

/**
 * CAROUSEL LEFT BUTTON POSITION
 * - left: Jarak dari kiri carousel (ATUR DI SINI)
 */
.carousel-control.left {
    left: 30px !important; /* LEFT BUTTON POSITION - Jarak dari kiri */
}

/**
 * CAROUSEL RIGHT BUTTON POSITION
 * - right: Jarak dari kanan carousel (ATUR DI SINI)
 */
.carousel-control.right {
    right: 30px !important; /* RIGHT BUTTON POSITION - Jarak dari kanan */
}

/**
 * CAROUSEL BUTTON HOVER EFFECT
 */
.carousel-control:hover {
    opacity: 1 !important;
    background: rgba(0, 0, 0, 0.85) !important;
    transform: translateY(-50%) scale(1.1) !important; /* HOVER SCALE - Enlarge saat hover */
}

/**
 * CAROUSEL BUTTON ICON SIZE
 */
.carousel-control .glyphicon {
    font-size: 2rem !important; /* CONTROL ICON SIZE - Ukuran icon */
    color: #ffffff !important;
    line-height: 50px !important;
}

/* ============================================================================
   FIX 7: RESPONSIVE BREAKPOINTS
   ============================================================================ */

/**
 * RESPONSIVE ADJUSTMENTS
 * - Adjust carousel height untuk berbagai device
 */

/* Desktop Large (1600px+) */
@media (max-width: 1600px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 500px !important; /* CAROUSEL HEIGHT - Desktop large */
    }
}

/* Laptop (1200px) */
@media (max-width: 1200px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 420px !important; /* CAROUSEL HEIGHT - Laptop */
    }
}

/* Tablet (991px) */
@media (max-width: 991px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 350px !important; /* CAROUSEL HEIGHT - Tablet */
    }
    
    .carousel-control {
        width: 40px !important;
        height: 40px !important;
    }
    
    .carousel-control.left {
        left: 15px !important;
    }
    
    .carousel-control.right {
        right: 15px !important;
    }
}

/* Mobile (768px) */
@media (max-width: 768px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 280px !important; /* CAROUSEL HEIGHT - Mobile */
    }
    
    .carousel-control {
        width: 35px !important;
        height: 35px !important;
    }
    
    /* Logo smaller on mobile */
    .pkp_site_name img {
        max-height: 38px !important;
    }
    
    /* Logo position adjustment for mobile */
    .navbar-brand,
    .pkp_site_name {
        top: 12px !important; /* MOBILE LOGO POSITION - Center di mobile */
    }
}

/* Mobile Small (575px) */
@media (max-width: 575px) {
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 220px !important; /* CAROUSEL HEIGHT - Small mobile */
    }
    
    .carousel-control {
        width: 30px !important;
        height: 30px !important;
    }
}

/* ============================================================================
   END OF CRITICAL FIXES v1.7
   ============================================================================ */
/**
 * ============================================================================
 * CRITICAL FIXES v1.8 - CAROUSEL CONTROLS, DROPDOWN, SPACING & SIDEBAR
 * ============================================================================
 * 1. Carousel arrow buttons fix (icon tidak muncul)
 * 2. About dropdown background fix (remove black box completely)
 * 3. Navigation spacing adjustment (lebih ke kanan dari logo)
 * 4. Sidebar modern & interactive design
 * 5. Carousel positioning above sidebar (break out grid Bootstrap)
 * ============================================================================
 */

/* ============================================================================
   FIX 1: CAROUSEL CONTROLS - FIX ARROW ICONS
   ============================================================================ */

/**
 * CAROUSEL CONTROL BUTTONS
 * - Fix untuk icon arrow yang tidak muncul
 * - Menggunakan font-family Glyphicons untuk compatibility
 */
.carousel-control {
    width: 55px !important; /* CONTROL SIZE - Ukuran button */
    height: 55px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    background: rgba(0, 0, 0, 0.7) !important; /* CONTROL BACKGROUND - Semi-transparent */
    border-radius: 50% !important;
    opacity: 0.85 !important;
    transition: all 0.3s ease !important;
    z-index: 20 !important; /* CONTROL Z-INDEX - Above carousel */
    border: 2px solid rgba(255, 255, 255, 0.3) !important; /* CONTROL BORDER - Subtle white border */
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
}

/**
 * CAROUSEL LEFT BUTTON POSITION
 * - left: Jarak dari kiri carousel
 */
.carousel-control.left {
    left: 25px !important; /* LEFT BUTTON POSITION */
}

/**
 * CAROUSEL RIGHT BUTTON POSITION
 * - right: Jarak dari kanan carousel
 */
.carousel-control.right {
    right: 25px !important; /* RIGHT BUTTON POSITION */
}

/**
 * CAROUSEL BUTTON HOVER EFFECT
 */
.carousel-control:hover {
    opacity: 1 !important;
    background: rgba(0, 0, 0, 0.9) !important;
    border-color: rgba(255, 255, 255, 0.6) !important;
    transform: translateY(-50%) scale(1.15) !important;
}

/**
 * CAROUSEL BUTTON ICON - FIX ARROW DISPLAY
 * - Menggunakan Unicode character untuk arrow
 * - Fallback ke Glyphicons font jika tersedia
 */
.carousel-control .glyphicon {
    font-size: 2.5rem !important; /* ICON SIZE */
    color: #ffffff !important; /* ICON COLOR */
    line-height: 1 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: 'Glyphicons Halflings', Arial, sans-serif !important;
    font-weight: normal !important;
    font-style: normal !important;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5) !important;
}

/**
 * LEFT ARROW ICON FIX
 * - Using content for fallback
 */
.carousel-control.left .glyphicon::before,
.carousel-control.left .icon-prev::before {
    content: "‹" !important; /* LEFT ARROW CHARACTER */
    font-size: 3rem !important;
    font-weight: bold !important;
    display: block !important;
}

/**
 * RIGHT ARROW ICON FIX
 * - Using content for fallback
 */
.carousel-control.right .glyphicon::before,
.carousel-control.right .icon-next::before {
    content: "›" !important; /* RIGHT ARROW CHARACTER */
    font-size: 3rem !important;
    font-weight: bold !important;
    display: block !important;
}

/* ============================================================================
   FIX 2: ABOUT DROPDOWN - COMPLETE BACKGROUND FIX
   ============================================================================ */

/**
 * DROPDOWN MENU BACKGROUND - REMOVE BLACK BOX COMPLETELY
 * - Force white background
 * - Remove all pseudo-elements
 * - Clean border & shadow
 */
.pkp_navigation_primary ul li ul,
.navbar-nav li ul,
.navbar-nav .dropdown-menu,
.pkp_navigation_primary .dropdown-menu {
    display: none !important;
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    background: #ffffff !important; /* DROPDOWN BACKGROUND - Pure white */
    border: 1px solid #d1d5db !important; /* DROPDOWN BORDER */
    border-radius: 8px !important; /* DROPDOWN ROUNDED CORNERS */
    box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important; /* DROPDOWN SHADOW */
    min-width: 230px !important;
    padding: 0.5rem 0 !important;
    margin-top: 0.5rem !important;
    z-index: 9999 !important;
    list-style: none !important;
    overflow: hidden !important; /* PREVENT OVERFLOW */
}

/**
 * FORCE REMOVE ALL PSEUDO-ELEMENTS CREATING BLACK BACKGROUND
 */
.pkp_navigation_primary ul li ul::before,
.pkp_navigation_primary ul li ul::after,
.navbar-nav li ul::before,
.navbar-nav li ul::after,
.dropdown-menu::before,
.dropdown-menu::after,
.pkp_navigation_primary::before,
.pkp_navigation_primary::after {
    display: none !important;
    content: none !important;
    background: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
}

/**
 * DROPDOWN ITEMS - CLEAN WHITE BACKGROUND
 */
.pkp_navigation_primary ul li ul li,
.navbar-nav li ul li,
.dropdown-menu li {
    display: block !important;
    width: 100% !important;
    background: #ffffff !important; /* ITEM BACKGROUND - White */
    margin: 0 !important;
    padding: 0 !important;
    border-bottom: 1px solid #f3f4f6 !important; /* ITEM SEPARATOR */
}

.pkp_navigation_primary ul li ul li:last-child,
.navbar-nav li ul li:last-child,
.dropdown-menu li:last-child {
    border-bottom: none !important;
}

/**
 * DROPDOWN LINKS - CLEAN STYLING
 */
.pkp_navigation_primary ul li ul li a,
.navbar-nav li ul li a,
.dropdown-menu li a {
    display: block !important;
    width: 100% !important;
    padding: 0.75rem 1.2rem !important;
    color: #374151 !important; /* LINK COLOR - Dark gray */
    background: #ffffff !important; /* LINK BACKGROUND - White */
    text-decoration: none !important;
    font-size: 0.9rem !important;
    transition: all 0.2s ease !important;
}

/**
 * DROPDOWN LINK HOVER - TEAL ACCENT
 */
.pkp_navigation_primary ul li ul li a:hover,
.navbar-nav li ul li a:hover,
.dropdown-menu li a:hover {
    background: #f0fdfa !important; /* HOVER BACKGROUND - Very light teal */
    color: #0d9488 !important; /* HOVER COLOR - Teal */
    padding-left: 1.5rem !important;
}

/* ============================================================================
   FIX 3: NAVIGATION SPACING - GESER LEBIH KE KANAN
   ============================================================================ */

/**
 * NAVIGATION HORIZONTAL POSITION
 * - left: Jarak dari logo (INCREASE untuk lebih ke kanan)
 * - Before: 200px, After: 250px (50px lebih ke kanan)
 */
.pkp_navigation_primary_row,
.pkp_navigation_primary {
    position: absolute !important;
    left: 250px !important; /* NAVIGATION LEFT - Lebih ke kanan dari logo (was 200px) */
    top: 50% !important;
    transform: translateY(-50%) !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    z-index: 100 !important;
}

/* ============================================================================
   FIX 4: CAROUSEL POSITIONING - ABOVE SIDEBAR (BREAK GRID)
   ============================================================================ */

/**
 * CAROUSEL FULL-WIDTH POSITIONING
 * - Break out dari Bootstrap grid
 * - Position di atas sidebar (z-index tinggi)
 * - Margin adjustment untuk hampir full-width
 */
.homepage-image,
.carousel,
.carousel-inner,
body .homepage-image,
body .carousel {
    width: 100vw !important; /* CAROUSEL WIDTH - Full viewport */
    max-width: none !important;
    /* CAROUSEL MARGIN - Break out dari container */
    margin-left: calc(-50vw + 50% + 20px) !important; /* +20px = Geser kanan, space dari kiri */
    margin-right: calc(-50vw + 50% - 20px) !important; /* -20px = Space dari kanan */
    height: 560px !important; /* CAROUSEL HEIGHT - Desktop */
    padding: 0 !important;
    position: relative !important;
    overflow: hidden !important;
    z-index: 50 !important; /* CAROUSEL Z-INDEX - Above sidebar */
    margin-bottom: 3rem !important; /* CAROUSEL BOTTOM SPACING */
}

/**
 * CAROUSEL WRAPPER
 */
.carousel-wrapper,
.homepage-image-wrapper {
    width: 100vw !important;
    max-width: none !important;
    margin-left: calc(-50vw + 50% + 20px) !important;
    margin-right: calc(-50vw + 50% - 20px) !important;
    padding: 0 !important;
    z-index: 50 !important;
}

/* ============================================================================
   FIX 5: SIDEBAR MODERN & INTERACTIVE DESIGN
   ============================================================================ */

/**
 * SIDEBAR CONTAINER
 * - Modern card-based design
 * - Interactive hover effects
 * - Clean spacing & shadows
 */
.pkp_sidebar,
aside.pkp_sidebar,
.sidebar,
aside.sidebar {
    background: #ffffff !important; /* SIDEBAR BACKGROUND */
    border-radius: 12px !important; /* SIDEBAR ROUNDED CORNERS */
    box-shadow: 0 4px 15px rgba(0,0,0,0.08) !important; /* SIDEBAR SHADOW */
    padding: 1.5rem !important; /* SIDEBAR PADDING */
    margin-bottom: 2rem !important;
    border: 1px solid #e5e7eb !important;
    transition: all 0.3s ease !important;
    overflow: hidden !important;
}

.pkp_sidebar:hover,
aside.pkp_sidebar:hover {
    box-shadow: 0 6px 25px rgba(0,0,0,0.12) !important; /* HOVER SHADOW - Deeper */
    transform: translateY(-2px) !important; /* HOVER LIFT EFFECT */
}

/**
 * SIDEBAR HEADINGS
 * - Modern typography
 * - Accent border
 */
.pkp_sidebar h2,
.pkp_sidebar h3,
.sidebar h2,
.sidebar h3,
aside h2,
aside h3 {
    color: #111827 !important; /* HEADING COLOR - Almost black */
    font-size: 1.25rem !important; /* HEADING SIZE */
    font-weight: 700 !important;
    margin-bottom: 1rem !important;
    padding-bottom: 0.75rem !important;
    border-bottom: 3px solid #0d9488 !important; /* HEADING BORDER - Teal accent */
    font-family: 'Poppins', sans-serif !important;
}

/**
 * SIDEBAR LISTS
 * - Clean list styling
 * - Interactive items
 */
.pkp_sidebar ul,
.sidebar ul,
aside ul {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
}

.pkp_sidebar ul li,
.sidebar ul li,
aside ul li {
    margin-bottom: 0.5rem !important;
    padding: 0 !important;
}

/**
 * SIDEBAR LINKS
 * - Modern button-like appearance
 * - Smooth hover transitions
 */
.pkp_sidebar a,
.sidebar a,
aside a {
    display: block !important;
    padding: 0.75rem 1rem !important;
    color: #4b5563 !important; /* LINK COLOR - Medium gray */
    text-decoration: none !important;
    background: #f9fafb !important; /* LINK BACKGROUND - Very light gray */
    border-radius: 8px !important;
    border-left: 3px solid transparent !important;
    transition: all 0.25s ease !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
}

/**
 * SIDEBAR LINK HOVER
 * - Teal accent
 * - Slide right effect
 */
.pkp_sidebar a:hover,
.sidebar a:hover,
aside a:hover {
    background: #f0fdfa !important; /* HOVER BACKGROUND - Light teal */
    color: #0d9488 !important; /* HOVER COLOR - Teal */
    border-left-color: #0d9488 !important; /* HOVER BORDER - Teal accent */
    padding-left: 1.25rem !important; /* HOVER INDENT - Slide right */
    transform: translateX(3px) !important;
}

/**
 * SIDEBAR ACTIVE LINK
 */
.pkp_sidebar a.active,
.pkp_sidebar a.current,
.sidebar a.active,
aside a.active {
    background: #0d9488 !important; /* ACTIVE BACKGROUND - Teal */
    color: #ffffff !important; /* ACTIVE COLOR - White */
    border-left-color: #0f766e !important; /* ACTIVE BORDER - Dark teal */
    font-weight: 600 !important;
}

/**
 * SIDEBAR BUTTONS
 * - CTA buttons (e.g., "Make a Submission")
 * - Prominent styling
 */
.pkp_sidebar button,
.pkp_sidebar .btn,
.sidebar button,
aside button,
.pkp_sidebar input[type="submit"] {
    width: 100% !important;
    padding: 0.875rem 1.5rem !important;
    background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%) !important; /* BUTTON GRADIENT */
    color: #ffffff !important;
    border: none !important;
    border-radius: 8px !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 12px rgba(13, 148, 136, 0.3) !important;
    text-align: center !important;
    text-decoration: none !important;
    display: block !important;
    margin-top: 1rem !important;
}

.pkp_sidebar button:hover,
.pkp_sidebar .btn:hover,
.sidebar button:hover,
aside button:hover {
    background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%) !important;
    box-shadow: 0 6px 20px rgba(13, 148, 136, 0.4) !important;
    transform: translateY(-2px) !important;
}

/**
 * SIDEBAR SECTIONS
 * - Separated content blocks
 */
.pkp_sidebar .section,
.sidebar .section,
aside .section,
.pkp_block {
    background: #ffffff !important;
    border: 1px solid #e5e7eb !important;
    border-radius: 10px !important;
    padding: 1.25rem !important;
    margin-bottom: 1.5rem !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
}

.pkp_sidebar .section:last-child,
.pkp_block:last-child {
    margin-bottom: 0 !important;
}

/**
 * SIDEBAR ICONS (if present)
 */
.pkp_sidebar .icon,
.sidebar .icon,
aside .icon {
    margin-right: 0.5rem !important;
    color: #0d9488 !important;
    font-size: 1.1rem !important;
}

/* ============================================================================
   FIX 6: RESPONSIVE ADJUSTMENTS
   ============================================================================ */

/**
 * TABLET RESPONSIVE (991px and below)
 */
@media (max-width: 991px) {
    /* Navigation spacing - reduce untuk tablet */
    .pkp_navigation_primary_row,
    .pkp_navigation_primary {
        left: 200px !important; /* Reduce spacing on tablet */
    }
    
    /* Carousel height adjustment */
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 400px !important;
    }
    
    /* Sidebar full-width on tablet */
    .pkp_sidebar,
    aside.pkp_sidebar {
        width: 100% !important;
        margin-bottom: 2rem !important;
    }
}

/**
 * MOBILE RESPONSIVE (768px and below)
 */
@media (max-width: 768px) {
    /* Carousel controls smaller */
    .carousel-control {
        width: 45px !important;
        height: 45px !important;
    }
    
    .carousel-control.left {
        left: 15px !important;
    }
    
    .carousel-control.right {
        right: 15px !important;
    }
    
    /* Sidebar stacks below content */
    .pkp_sidebar,
    aside.pkp_sidebar {
        margin-top: 2rem !important;
    }
    
    /* Navigation spacing - minimal for mobile */
    .pkp_navigation_primary_row,
    .pkp_navigation_primary {
        left: 150px !important;
    }
}

/* ============================================================================
   END OF CRITICAL FIXES v1.8
   ============================================================================ */
