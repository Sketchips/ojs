/**
 * ============================================================================
 * MODERN OJS THEME - CUSTOM ENHANCEMENT
 * ============================================================================
 * Tema modern dengan carousel besar, header compact, dan interaksi smooth
 * Warna: Gradient biru-ungu modern dengan aksen orange
 * 
 * FITUR UTAMA:
 * - Header compact dengan search bar di kanan
 * - Carousel banner besar dan responsif
 * - Animasi dan transisi smooth
 * - Design modern dengan gradient dan shadow
 * - Fully responsive
 * ============================================================================
 */

/* ============================================================================
   1. IMPORT FONTS & RESET
   ============================================================================ */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

/* ============================================================================
   2. CSS VARIABLES - PROFESSIONAL COLOR PALETTE (JURNAL)
   ============================================================================ */
:root {
    /* Professional Dark Colors */
    --primary-dark: #1a1a1a;        /* Almost black - main color */
    --primary-charcoal: #2d3748;    /* Charcoal gray - secondary */
    --accent-teal: #0d9488;         /* Teal - professional accent */
    --accent-slate: #475569;        /* Slate blue - subtle accent */
    
    /* Neutral Colors */
    --dark-gray: #374151;           /* Dark gray for text */
    --medium-gray: #6b7280;         /* Medium gray */
    --light-gray: #f3f4f6;          /* Light gray background */
    --white: #ffffff;
    --text-primary: #111827;        /* Very dark gray (almost black) */
    --text-secondary: #4b5563;      /* Medium dark gray */
    
    /* Professional Gradients (Subtle) */
    --gradient-primary: linear-gradient(135deg, #1a1a1a 0%, #2d3748 100%);
    --gradient-accent: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%);
    --gradient-dark: linear-gradient(to bottom, #1f2937 0%, #111827 100%);
    --gradient-light: linear-gradient(to bottom, #f9fafb 0%, #f3f4f6 100%);
    
    /* Shadows (Professional & Subtle) */
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
    --shadow-md: 0 4px 6px rgba(0,0,0,0.07);
    --shadow-lg: 0 10px 20px rgba(0,0,0,0.1);
    --shadow-xl: 0 20px 30px rgba(0,0,0,0.12);
    --shadow-glow: 0 0 15px rgba(13, 148, 136, 0.2);
    
    /* Spacing */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;
    
    /* Border Radius */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --radius-full: 9999px;
    
    /* Transitions */
    --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ============================================================================
   3. GLOBAL STYLES
   ============================================================================ */
body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-primary);
    background: linear-gradient(to bottom, #f8fafc 0%, #e2e8f0 100%);
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
}

h1 { font-size: 2.5rem; }
h2 { font-size: 2rem; }
h3 { font-size: 1.75rem; }

a {
    text-decoration: none;
    color: var(--primary-blue);
    transition: all var(--transition-base);
}

a:hover {
    color: var(--primary-purple);
}

/* ============================================================================
   4. HEADER - COMPACT & MODERN
   ============================================================================ */
.navbar,
.pkp_structure_head,
header.navbar,
.navbar-default {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.98) !important;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
    z-index: 9999;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    min-height: 65px !important;
    max-height: 65px !important;
    transition: all var(--transition-base);
}

/* Header saat scroll - lebih compact */
.navbar.scrolled,
header.navbar.scrolled {
    min-height: 60px !important;
    max-height: 60px !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.12);
}

/* Container header */
.navbar .container,
.navbar-header {
    padding: 0 !important;
    margin: 0 !important;
    height: 65px;
    display: flex;
    align-items: center;
}

/* ============================================================================
   5. NAVIGATION MENU - MODERN STYLE (INTEGRATED IN HEADER)
   ============================================================================ */

/* Force navigation to be inside header */
.pkp_head_wrapper,
.pkp_structure_head {
    position: relative !important;
    z-index: 1000 !important;
}

.navbar-nav,
.pkp_navigation_primary,
.pkp_navigation_primary ul,
.pkp_navigation_primary_row {
    margin: 0 !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    height: 65px !important;
    position: relative !important;
    background: transparent !important;
}

/* Pastikan navigation dalam satu baris dengan header */
.pkp_navigation_primary_row {
    position: absolute !important;
    top: 0 !important;
    left: 200px !important;
    height: 65px !important;
}

.navbar-nav > li,
.pkp_navigation_primary > ul > li,
.pkp_navigation_primary li {
    margin: 0 !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    list-style: none !important;
}

.navbar-nav > li > a,
.pkp_navigation_primary a,
.pkp_navigation_primary ul li a {
    color: var(--text-primary) !important;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
    padding: 0.6rem 1rem !important;
    margin: 0 0.2rem !important;
    border-radius: var(--radius-md) !important;
    transition: all var(--transition-base) !important;
    position: relative !important;
    display: inline-flex !important;
    align-items: center !important;
    height: auto !important;
    background: transparent !important;
    text-decoration: none !important;
}

/* Hover effect - Professional teal */
.navbar-nav > li > a:hover,
.pkp_navigation_primary a:hover,
.navbar-nav > li.active > a,
.pkp_navigation_primary li.current > a {
    color: var(--white) !important;
    background: var(--accent-teal) !important;
    transform: none !important;
}

/* Active menu underline - removed, using background instead */
.navbar-nav > li.active > a,
.pkp_navigation_primary li.current > a {
    color: var(--white) !important;
    background: var(--accent-teal) !important;
}

/* ============================================================================
   6. SEARCH BAR - POSITIONED NEXT TO USER ACCOUNT
   ============================================================================ */
.navbar-form,
.pkp_head_wrapper .search_form,
.navbar-right form,
form[role="search"] {
    position: absolute !important;
    right: 120px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
}

.navbar-form .form-control,
.search_form input[type="text"],
.search_form input[type="search"],
input.form-control[type="search"] {
    width: 200px !important;
    height: 38px !important;
    padding: 0.4rem 2.5rem 0.4rem 1rem !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: var(--radius-full) !important;
    background: #f8f9fa !important;
    color: var(--text-primary) !important;
    font-size: 0.85rem !important;
    transition: all var(--transition-base) !important;
    box-shadow: none !important;
}

.navbar-form .form-control:focus,
.search_form input:focus {
    width: 250px !important;
    border-color: var(--accent-teal) !important;
    box-shadow: 0 0 0 2px rgba(13, 148, 136, 0.1) !important;
    outline: none !important;
    background: var(--white) !important;
}

/* Search button - Hanya ikon dengan glyphicon */
.navbar-form button,
.search_form button,
button[type="submit"].btn,
.pkp_search button {
    position: absolute !important;
    right: 5px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 28px !important;
    height: 28px !important;
    border-radius: var(--radius-full) !important;
    background: var(--accent-teal) !important;
    border: none !important;
    color: var(--white) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: all var(--transition-base) !important;
    padding: 0 !important;
    line-height: 1 !important;
}

.navbar-form button:hover,
.search_form button:hover,
.pkp_search button:hover {
    background: var(--primary-charcoal) !important;
    transform: translateY(-50%) scale(1.08) !important;
}

/* Force show glyphicon, hide text */
.navbar-form button *:not(.glyphicon),
.search_form button *:not(.glyphicon),
.pkp_search button *:not(.glyphicon) {
    display: none !important;
}

/* Search icon - Force display glyphicon */
.navbar-form button .glyphicon,
.search_form button .glyphicon,
.pkp_search button .glyphicon,
.navbar-form button .glyphicon-search,
.search_form button .glyphicon-search {
    font-size: 12px !important;
    display: inline-block !important;
    line-height: 1 !important;
    color: var(--white) !important;
}

/* Fallback: If no glyphicon, add content */
.navbar-form button:empty::before,
.search_form button:empty::before,
.pkp_search button:empty::before {
    content: "\e003" !important;
    font-family: 'Glyphicons Halflings' !important;
    font-size: 12px !important;
    display: inline-block !important;
}

/* ============================================================================
   7. USER ACCOUNT - POSITIONED AT TOP RIGHT (FIXED WITH HIGH SPECIFICITY)
   ============================================================================ */
.navbar-right,
.pkp_navigation_user,
.navbar-nav.navbar-right,
.pkp_structure_head .navbar-right,
.pkp_head_wrapper .pkp_navigation_user {
    position: absolute !important;
    right: 15px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    list-style: none !important;
    z-index: 200 !important;
}

.navbar-right > li,
.pkp_navigation_user > ul > li,
.pkp_navigation_user li {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* Account button - FORCE STYLING dengan specificity tinggi */
.pkp_structure_head .navbar-right > li > a,
.pkp_structure_head .pkp_navigation_user a,
.pkp_head_wrapper .pkp_navigation_user ul li a,
.navbar-right > li > a,
.pkp_navigation_user a,
.pkp_navigation_user ul li a,
a.profile {
    color: var(--white) !important;
    font-weight: 600 !important;
    font-size: 0.85rem !important;
    padding: 0.6rem 1.4rem !important;
    border-radius: var(--radius-full) !important;
    background: var(--primary-dark) !important;
    background-color: var(--primary-dark) !important;
    transition: all var(--transition-base) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    white-space: nowrap !important;
    line-height: 1.2 !important;
}

/* Hover state - FORCE */
.pkp_structure_head .navbar-right > li > a:hover,
.pkp_structure_head .pkp_navigation_user a:hover,
.navbar-right > li > a:hover,
.pkp_navigation_user a:hover,
a.profile:hover {
    background: var(--accent-teal) !important;
    background-color: var(--accent-teal) !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 4px 14px rgba(13, 148, 136, 0.4) !important;
    border-color: var(--accent-teal) !important;
    color: var(--white) !important;
}

/* User icon/avatar */
.navbar-right .glyphicon,
.pkp_navigation_user .glyphicon {
    font-size: 14px !important;
}

/* Dropdown for logged-in user */
.navbar-right .dropdown-menu {
    right: 0 !important;
    left: auto !important;
    margin-top: 0.5rem !important;
    border: none !important;
    border-radius: var(--radius-md) !important;
    box-shadow: var(--shadow-lg) !important;
}

/* ============================================================================
   8. CAROUSEL BANNER - FULL WIDTH (DILUAR GRID BOOTSTRAP)
   ============================================================================ */

/* Adjust body padding for compact header */
body {
    padding-top: 65px !important;
}

/* Carousel container - Full width, outside grid (col-md-12) */
.carousel,
.homepage-image,
.pkp_page_index .carousel,
.slider-container,
.pkp_page_index .homepage-image {
    width: 100vw !important;
    max-width: 100vw !important;
    height: 450px !important;
    margin: 0 !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    margin-bottom: 3rem !important;
    padding: 0 !important;
    position: relative;
    overflow: hidden;
    border-radius: 0 !important;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
}

/* Alternative: If carousel is in col-md-12, make it full width */
.col-md-12 .carousel,
.row > .col-md-12 > .carousel {
    width: 100vw !important;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
}

/* Carousel items */
.carousel-inner,
.carousel .item,
.carousel-item {
    width: 100% !important;
    height: 450px !important;
    position: relative;
}

/* Carousel images - Full width landscape dengan consistent sizing */
.carousel img,
.carousel-item img,
.homepage-image img {
    width: 100% !important;
    height: 450px !important;
    object-fit: cover !important;
    object-position: center center !important;
    display: block !important;
    border-radius: 0 !important;
}

/* Force consistent image sizing - prevent zoom/distortion */
.carousel .item img,
.carousel-inner .item img,
.carousel-inner > .item > img {
    width: 100% !important;
    height: 450px !important;
    object-fit: cover !important;
    object-position: center center !important;
    max-width: 100% !important;
    min-width: 100% !important;
}

/* Regular homepage image (non-carousel) - normal size */
img.img-responsive:not(.carousel img):not(.homepage-image img) {
    width: 100% !important;
    height: auto !important;
    max-height: 400px !important;
    object-fit: cover !important;
}

/* Gradient overlay untuk carousel - Lebih subtle */
.carousel-inner::after,
.carousel .item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 100%);
    pointer-events: none;
    z-index: 1;
}

/* Carousel caption - Proportional untuk landscape */
.carousel-caption {
    position: absolute;
    bottom: 40px !important;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    text-align: center;
    width: 80%;
    max-width: 800px;
}

.carousel-caption h1,
.carousel-caption h2,
.carousel-caption h3 {
    color: var(--white) !important;
    font-size: 2.2rem !important;
    font-weight: 700 !important;
    text-shadow: 0 3px 15px rgba(0, 0, 0, 0.6);
    margin-bottom: 0.8rem !important;
    line-height: 1.2;
}

.carousel-caption p {
    color: var(--white) !important;
    font-size: 1.1rem !important;
    font-weight: 400 !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    margin-bottom: 1rem !important;
}

/* Carousel controls - Simple and clean */
.carousel-control {
    width: 45px !important;
    height: 45px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    background: rgba(0, 0, 0, 0.5) !important;
    border-radius: 50% !important;
    opacity: 0.7 !important;
    transition: all var(--transition-base) !important;
}

.carousel-control.left {
    left: 20px !important;
}

.carousel-control.right {
    right: 20px !important;
}

.carousel-control:hover {
    opacity: 1 !important;
    background: rgba(0, 0, 0, 0.7) !important;
}

.carousel-control .glyphicon {
    font-size: 1.5rem !important;
    color: var(--white) !important;
}

/* Carousel indicators - Simple dots */
.carousel-indicators {
    bottom: 20px !important;
    z-index: 3 !important;
}

.carousel-indicators li {
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.6) !important;
    border: 1px solid var(--white) !important;
    margin: 0 5px !important;
    transition: all var(--transition-base) !important;
}

.carousel-indicators .active {
    width: 30px !important;
    border-radius: 5px !important;
    background: var(--white) !important;
}

/* ============================================================================
   9. MAIN CONTENT - MODERN CARDS & LAYOUT
   ============================================================================ */
.container,
.pkp_structure_main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
}

/* Article cards */
.article,
.article-summary,
.obj_article_summary {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
    border: 1px solid #e2e8f0;
}

.article:hover,
.article-summary:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
    border-color: var(--primary-blue);
}

/* Article title */
.article h2,
.article h3,
.article-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-md);
    line-height: 1.3;
    transition: color var(--transition-base);
}

.article h2:hover,
.article h3:hover,
.article-title:hover {
    color: var(--primary-purple);
}

/* ============================================================================
   10. BUTTONS - PROFESSIONAL STYLE
   ============================================================================ */
/* Buttons - Professional style */
.btn,
button:not(.navbar-form button):not(.search_form button),
input[type="submit"],
.pkp_button {
    padding: 0.65rem 1.5rem !important;
    border-radius: var(--radius-md) !important;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
    border: none !important;
    cursor: pointer !important;
    transition: all var(--transition-base) !important;
    letter-spacing: 0.3px;
    box-shadow: var(--shadow-sm) !important;
}

.btn-primary,
.btn-success {
    background: var(--primary-dark) !important;
    color: var(--white) !important;
}

.btn-primary:hover,
.btn-success:hover {
    background: var(--accent-teal) !important;
    transform: translateY(-2px) !important;
    box-shadow: var(--shadow-md) !important;
}

.btn-primary:hover,
.btn-success:hover {
    transform: translateY(-3px) !important;
    box-shadow: var(--shadow-lg) !important;
}

.btn-default {
    background: var(--white) !important;
    color: var(--text-primary) !important;
    border: 2px solid #e2e8f0 !important;
}

.btn-default:hover {
    background: var(--light-gray) !important;
    transform: translateY(-3px) !important;
}

/* ============================================================================
   11. FOOTER - MODERN GRADIENT
   ============================================================================ */
.pkp_structure_footer,
footer {
    background: var(--primary-dark) !important;
    color: var(--white) !important;
    padding: var(--space-2xl) var(--space-md) !important;
    margin-top: var(--space-2xl);
    text-align: center;
    border-top: 3px solid var(--accent-teal);
}

.pkp_structure_footer a,
footer a {
    color: var(--white) !important;
    font-weight: 500;
    text-decoration: underline;
    opacity: 0.9;
    transition: opacity var(--transition-base);
}

.pkp_structure_footer a:hover,
footer a:hover {
    opacity: 1;
}

/* ============================================================================
   12. ANIMATIONS & INTERACTIVE ELEMENTS
   ============================================================================ */

/* Smooth fade in animation */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.article,
.article-summary {
    animation: fadeInUp 0.6s ease-out;
}

/* Pulse animation for important elements */
@keyframes pulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.05);
    }
}

/* Glow effect */
@keyframes glow {
    0%, 100% {
        box-shadow: 0 0 20px rgba(103, 126, 234, 0.4);
    }
    50% {
        box-shadow: 0 0 30px rgba(103, 126, 234, 0.8);
    }
}

/* Loading skeleton */
.skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
}

@keyframes loading {
    0% {
        background-position: 200% 0;
    }
    100% {
        background-position: -200% 0;
    }
}

/* ============================================================================
   13. RESPONSIVE DESIGN
   ============================================================================ */

/* Tablet */
@media (max-width: 992px) {
    /* Navigation position */
    .pkp_navigation_primary_row {
        left: 150px !important;
    }
    
    /* Search bar adjustments */
    .navbar-form,
    .search_form {
        right: 100px !important;
    }
    
    .navbar-form .form-control,
    .search_form input {
        width: 180px !important;
    }
    
    .navbar-form .form-control:focus,
    .search_form input:focus {
        width: 220px !important;
    }
    
    /* Carousel height - maintain aspect ratio */
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 380px !important;
    }
    
    .carousel-caption h1,
    .carousel-caption h2,
    .carousel-caption h3 {
        font-size: 1.8rem !important;
    }
    
    .carousel-caption p {
        font-size: 1rem !important;
    }
}

/* Mobile */
@media (max-width: 768px) {
    /* Smaller header */
    .navbar,
    header.navbar {
        min-height: 60px !important;
    }
    
    body {
        padding-top: 60px !important;
    }
    
    /* Logo smaller */
    .pkp_site_name img {
        max-height: 40px !important;
    }
    
    /* Navigation stack */
    .pkp_navigation_primary_row {
        position: relative !important;
        left: 0 !important;
        width: 100% !important;
        height: auto !important;
        margin-top: 60px !important;
    }
    
    /* Search and account stack */
    .navbar-form,
    .search_form,
    .navbar-right {
        position: relative !important;
        right: auto !important;
        top: auto !important;
        transform: none !important;
        margin: 0.5rem !important;
    }
    
    /* Carousel height - smaller for mobile */
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 300px !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        width: 100% !important;
    }
    
    .carousel-caption {
        bottom: 20px !important;
    }
    
    .carousel-caption h1,
    .carousel-caption h2,
    .carousel-caption h3 {
        font-size: 1.3rem !important;
    }
    
    .carousel-caption p {
        font-size: 0.9rem !important;
    }
    
    /* Carousel controls smaller */
    .carousel-control {
        width: 35px !important;
        height: 35px !important;
    }
    
    .carousel-control.left {
        left: 10px !important;
    }
    
    .carousel-control.right {
        right: 10px !important;
    }
}

/* Small mobile */
@media (max-width: 480px) {
    .navbar-brand,
    .pkp_site_name a {
        font-size: 0.95rem !important;
    }
    
    .carousel,
    .carousel-inner,
    .carousel .item,
    .carousel img {
        height: 250px !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    
    .carousel-caption h1,
    .carousel-caption h2,
    .carousel-caption h3 {
        font-size: 1.1rem !important;
    }
    
    .carousel-caption p {
        font-size: 0.85rem !important;
        display: none; /* Hide description on very small screens */
    }
}

/* ============================================================================
   14. UTILITY CLASSES
   ============================================================================ */
.text-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.shadow-glow {
    box-shadow: var(--shadow-glow);
}

.card-hover {
    transition: all var(--transition-base);
}

.card-hover:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-xl);
}

/* Smooth transitions for all interactive elements */
* {
    transition: background-color var(--transition-base),
                color var(--transition-base),
                border-color var(--transition-base),
                box-shadow var(--transition-base);
}

/* ============================================================================
   15. CUSTOM SCROLLBAR
   ============================================================================ */
::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: var(--light-gray);
}

::-webkit-scrollbar-thumb {
    background: var(--gradient-primary);
    border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb:hover {
    background: var(--gradient-accent);
}

/* ============================================================================
   END OF MODERN OJS THEME
   ============================================================================ */
